[Unit]
Description=Reth Research Node
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/reth

Restart=always
RestartSec=5
TimeoutStopSec=120
LimitNOFILE=1048576

Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Xeon Gold 5412U / 128 GB tuning. Override per host as needed.
Environment=RETH_RESERVED_CPU_CORES=2
Environment=RETH_ENGINE_CROSS_BLOCK_CACHE_MB=16384
Environment=RETH_NATIVE_BUILD=0

# Memory guardrails. Sized for 128 GB hosts; reduce on smaller boxes.
MemoryHigh=96G
MemoryMax=112G

# Force a rebuild on each restart so a `git pull` is actually picked up.
# `run_xeon_perf.sh` invokes `cargo build --release -p reth-research-bin`
# when target/release/reth-research is missing — removing the binary
# here is what makes that rebuild fire. Earlier versions of this unit
# pointed at target/maxperf/, which is not where the script writes the
# binary, so the rm was silently a no-op.
ExecStartPre=/usr/bin/rm -f /home/ubuntu/reth/target/release/reth-research

ExecStart=/home/ubuntu/reth/bin/reth-research/scripts/run_xeon_perf.sh \
  --authrpc.jwtsecret /secrets/jwt.hex \
  --research.csv 7904-prelim=/home/ubuntu/test_configs/7904_prelim_numbers.csv \
  --research.amsterdam \
  --research.backfill \
  --research.backfill-concurrency 22 \
  --research.db-path /home/ubuntu/reth/divergences.sqlite \
  --research.max-divergences-per-block 8192

[Install]
WantedBy=multi-user.target
